-- ====================== MAIN LOOP ======================
RunService.Heartbeat:Connect(function()
    if not Character or not HumanoidRootPart then return end

    -- Speed Boost
    if Config.SpeedBoost > 0 then
        local moveDir = Humanoid.MoveDirection
        if moveDir.Magnitude > 0 then
            local velocity = moveDir * Config.SpeedBoost
            SpeedBypass.Velocity = velocity
            HumanoidRootPart.AssemblyLinearVelocity = Vector3.new(
                velocity.X,
                HumanoidRootPart.AssemblyLinearVelocity.Y,
                velocity.Z
            )
        end
    end

    -- Aimbot Radius Visual
    if AimbotRadiusVisual then
        AimbotRadiusVisual.Visible = Config.ShowAimbotRadius
        AimbotRadiusVisual.Radius = Config.AimbotRadius
    end
end)

-- Timer
spawn(function()
    local timeLeft = 25 * 60
    while timeLeft > 0 and TimerLabel do
        local minutes = math.floor(timeLeft / 60)
        local seconds = timeLeft % 60
        TimerLabel.Text = string.format("Free Trial: %02d:%02d", minutes, seconds)
        timeLeft -= 1
        task.wait(1)
    end
end)

-- Keybinds
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    if input.KeyCode == Enum.KeyCode.X then
        Config.Aimbot = not Config.Aimbot
        AimbotRadiusVisual.Visible = Config.Aimbot
        print("Aimbot:", Config.Aimbot)
    elseif input.KeyCode == Enum.KeyCode.V then
        Config.SpeedBoost = Config.SpeedBoost > 0 and 0 or 59
        print("Speed Boost:", Config.SpeedBoost)
    elseif input.KeyCode == Enum.KeyCode.Z then
        Config.AutoSteal = not Config.AutoSteal
        print("Auto Steal:", Config.AutoSteal)
    end
end)

-- Infinite Jump
UserInputService.JumpRequest:Connect(function()
    if Config.InfiniteJump then
        Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

